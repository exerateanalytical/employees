# =============================================================================
#  OPES HEALTH SYSTEMS — AI EMPLOYEES ENVIRONMENT CONFIGURATION
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# =============================================================================

# ─── Claude AI (Required) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Email / SendGrid ────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@opeshealthsystems.com
FROM_NAME=Opes Health Systems

# ─── WhatsApp Business API (360dialog or Meta Cloud API) ─────────────────────
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id

# ─── Social Media APIs ───────────────────────────────────────────────────────
# Facebook / Instagram (Meta)
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_long_lived_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORGANIZATION_ID=your_linkedin_org_id

# Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ─── CRM / Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./opes_employees.db
# For production: postgresql://user:password@host:5432/opes_db

# ─── Web Crawling ────────────────────────────────────────────────────────────
CRAWL_DELAY_SECONDS=2
MAX_CONCURRENT_CRAWLS=3

# ─── Notifications ───────────────────────────────────────────────────────────
# Slack webhook for internal alerts (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ─── Application Settings ────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=generate_a_long_random_secret_key_here

# ─── Timezone ────────────────────────────────────────────────────────────────
# Central Africa: Africa/Douala
# West Africa: Africa/Lagos
# East Africa: Africa/Nairobi
DEFAULT_TIMEZONE=Africa/Douala
